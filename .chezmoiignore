# Secret material and credentials are never owned by this repository.
README.md
.doppler.env
.env
.env.*
.ssh/**
.aws/**
.config/gh/**

# MCP, plugin, skill, and coding-agent primitives retain their native or
# repository authorities. Chezmoi may carry a reviewed projection later, but
# it does not own these directories or their payloads.
.agents/**
.claude/**
.codex/**
.cursor/**
.factory/**

# The current shell profile describes the MacBook's interactive developer
# toolchain. Keep the Mini's existing shell state until a reviewed host overlay
# replaces it; the Topgrade slice below is independently safe to adopt now.
{{ if eq .chezmoi.hostname "macmini" -}}
.zshrc
{{ end -}}

# Prove the higher-frequency observation and split cleanup lanes on the
# always-on Mini before projecting them onto the MacBook.
{{ if ne .chezmoi.hostname "macmini" -}}
.local/bin/dependency-drift.sh
.local/bin/dependency-maintenance-weekly.sh
Library/LaunchAgents/com.cianosullivan.dependency-drift.plist
Library/LaunchAgents/com.cianosullivan.dependency-maintenance-weekly.plist
Library/LaunchAgents/ie.cianos.claude-remote.plist
{{ end -}}

# Refuse to render onto an unreviewed host.
{{ if not (or (eq .chezmoi.hostname "Mac") (eq .chezmoi.hostname "Cians-Mac") (eq .chezmoi.hostname "macmini")) -}}
*
{{ end -}}
