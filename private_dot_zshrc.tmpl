# Claude Code settings
# NB: these only affect a *terminal* claude. As of 2026-08-04 this machine is
# Claude Desktop only (no CLI on PATH) — Desktop does not inherit shell exports,
# so these are inert here. Retained so they apply if a CLI is reinstalled.
export ENABLE_TOOL_SEARCH=true
export ENABLE_EXPERIMENTAL_MCP_CLI=false
export SLASH_COMMAND_TOOL_CHAR_BUDGET=30000

# Python 3.14 user scripts
export PATH="$PATH:{{ .chezmoi.homeDir }}/Library/Python/3.14/bin"

# Secrets: none are exported here. Agents and ad-hoc commands read 1Password at
# call time through the service account in ~/.config/op/service-account.token:
#   op run --environment v5mcungkaswrwwro5ckzrena5q -- <cmd>    # shared values
#   op read "op://Agent Runtime/<item id>/<field>"             # single-consumer items
# ~/.zshenv injects the op:// references in ~/.config/op/agent-runtime.env.

# pyenv configuration
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
# Keep Homebrew ahead of macOS /usr/local shims, and expose unversioned `python`
# for older tools while pyenv remains the version switcher.
export PATH="/opt/homebrew/opt/python@3.13/libexec/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
eval "$(pyenv init - zsh --no-rehash)"

# Antigravity (agy resolves from ~/.local/bin; this covers the app-bundled tree)
export PATH="{{ .chezmoi.homeDir }}/.antigravity/antigravity/bin:$PATH"

# .NET SDK 10 + global tools (PAC CLI MCP, Dataverse MCP)
# .NET 8 and 9 also installed but 10 is default (PAC CLI needs dnx from .NET 10)
export DOTNET_ROOT="/opt/homebrew/opt/dotnet/libexec"
export PATH="/opt/homebrew/opt/dotnet/bin:$HOME/.dotnet/tools:$PATH"

# Agent 365 CLI — needs .NET roll-forward from 8→10
export DOTNET_ROLL_FORWARD=LatestMajor

# ~/.local/bin — agy, cursor-agent, droid, amp, dcg, repowire, no-mistakes
export PATH="$HOME/.local/bin:$PATH"

# pnpm
export PNPM_HOME="{{ .chezmoi.homeDir }}/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# tidy — no-Git-Town manual-fallback for sync + prune.
# Resets local main to origin/main (with confirmation if local is ahead),
# deletes local branches whose remote is gone, prunes worktree metadata.
# Bypasses Git Town's interactive=false safety net which blocks `git sync`
# in non-TTY contexts. See ~/Repositories/Claudian/CLAUDE.md §Session discipline.
tidy() {
  emulate -L zsh
  setopt err_return pipefail

  git fetch origin --prune --quiet || { echo "tidy: fetch failed" >&2; return 1; }

  local current
  current=$(git rev-parse --abbrev-ref HEAD)
  if [[ "$current" != "main" ]]; then
    echo "tidy: switch to main first (currently on $current)" >&2
    return 1
  fi

  local ahead
  ahead=$(git rev-list --count origin/main..main)
  if (( ahead > 0 )); then
    echo "tidy: $ahead local commits ahead of origin/main — inspect first:"
    git log --oneline origin/main..main | head -10
    echo
    if ! read -q "REPLY?reset --hard origin/main? [y/N] "; then
      echo
      echo "tidy: aborted (local commits preserved)"
      return 1
    fi
    echo
    git reset --hard origin/main
  fi

  # Prune local branches whose remote is gone
  local gone_branches
  gone_branches=$(git branch -vv | awk '/: gone\]/ && $1 != "*" {print $1}')
  if [[ -n "$gone_branches" ]]; then
    echo "$gone_branches" | while IFS= read -r b; do
      echo "tidy: deleting local branch $b (remote gone)"
      git branch -D "$b"
    done
  fi

  git worktree prune -v
  echo "tidy: done"
}

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

# dcg: warn if hook was silently removed from Claude Code settings
if command -v dcg &>/dev/null && command -v jq &>/dev/null; then
  if [ -f "$HOME/.claude/settings.json" ] &&      ! jq -e '.hooks.PreToolUse[]? | select(.hooks[]?.command | test("dcg$"))'        "$HOME/.claude/settings.json" &>/dev/null; then
    printf '\033[1;33m[dcg] Hook missing from ~/.claude/settings.json — run: dcg install\033[0m\n'
  fi
fi

# bun completions
[ -s "{{ .chezmoi.homeDir }}/.bun/_bun" ] && source "{{ .chezmoi.homeDir }}/.bun/_bun"

# flow-cli (guarded — an uninstall must not error every new shell)
[ -r /opt/homebrew/opt/flow-cli/flow.plugin.zsh ] && source /opt/homebrew/opt/flow-cli/flow.plugin.zsh

# 1Password shell plugins (gh, aws and the like), interactive shells only; skipped inside Claude Code.
[[ -z "${CLAUDECODE:-}" ]] && source {{ .chezmoi.homeDir }}/.config/op/plugins.sh
